{
  "name": "money-dumb",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "lint": "eslint",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "version:next": "node scripts/version.mjs",
    "test:unit": "node tests/verify_math_invariants_empirical.js && node tests/verify_m6_adversarial.js",
    "test:e2e": "node tests/e2e/runner.js",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/postgres": "^0.10.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "lucide-react": "^0.562.0",
    "next": "^16.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "knip": "^6.42.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "ws": "^8.21.0",
    "sharp": "^0.35.5",
    "nanoid": "^3.3.17",
    "follow-redirects": "^1.16.1",
    "source-map-js": "^1.2.2"
  },
  "knip": {
    "entry": [
      "scripts/*.mjs",
      "tests/**/*.js",
      "app/dashboard/components/DashboardCharts.tsx",
      "app/dashboard/this-month/components/ForecastAndFlowDeck.tsx",
      "app/lib/db.ts"
    ],
    "ignoreExportsUsedInFile": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
