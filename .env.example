# ==========================================
# money-dumb — Environment Template
# ==========================================
# All real secrets and API tokens are managed via Doppler:
#   doppler --no-check-version setup --project money-dumb --config dev
#   doppler --no-check-version run -- npm run dev
# ==========================================

# ── Server & Routing Configuration ────────
NODE_ENV=development
PORT=3000
BASE_URL=/
SESSION_SECRET=your_random_256_bit_hex_secret_here

# ── Database Configuration ────────────────
# Local dev uses SQLite automatically when USE_SQLITE=true or NODE_ENV=development
USE_SQLITE=true
SQLITE_DB_PATH=moneydumb.db

# Production Postgres URL (stored in Doppler stg/prd)
# POSTGRES_URL=postgres://user:password@host:5432/dbname

